---
import Layout from "~/layouts/Layout.astro";
import LocaleRedirect from "~/components/i18n/LocaleRedirect.astro";
import Contact from "~/components/content/Contact.astro";
import About from "~/components/content/About.astro";
import Portfolio from "~/components/content/Portfolio.astro";
import Experiences from "~/components/content/Experiences.astro";
import Travels from "~/components/content/Travels.astro";
import Splash from "~/components/content/Splash.astro";
import { t } from "~/i18n/ui";
import { personGraph } from "~/data/person";

const locale = "es" as const;
const ui = t(locale);
---

<Layout
  title={ui.meta.homeTitle}
  description={ui.meta.homeDescription}
  slug="es"
  jsonLd={personGraph}
  locale={locale}
>
  <LocaleRedirect />
  <Splash splashTitle={ui.splash.home} ref="/es#about" />
  <div class="px-8 py-32 space-y-24">
    <About locale={locale} />
    <Experiences locale={locale} />
    <Portfolio locale={locale} />
    <Travels locale={locale} />
    <Contact locale={locale} />
  </div>
</Layout>

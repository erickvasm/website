---
import Layout from "~/layouts/Layout.astro";
import Buttom from "~/components/ui/Buttom.astro";
import { t } from "~/i18n/ui";

const ui = t("es");
---

<Layout title={ui.notFound.title} description={ui.notFound.message}>
  <div class="flex items-center justify-center min-h-[70vh] px-8 py-32">
    <div class="text-center space-y-6">
      <h1 class="text-9xl font-bold">404</h1>
      <h2 class="text-4xl font-bold">{ui.notFound.title}</h2>
      <p class="text-lg text-article">{ui.notFound.message}</p>
      <div class="flex justify-center">
        <Buttom title={ui.notFound.cta} icon="mdi:home" target="" ref="/" />
      </div>
    </div>
  </div>
</Layout>

---
import ContentSection from "./ContentSection.astro";
import { t, type Locale } from "~/i18n/ui";
import { about } from "~/i18n/content/about";

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
const content = about[locale];
---

<ContentSection title={ui.about.title} id="about">
  <Fragment slot="lead">
    <span class="text-primary">{content.highlight}</span>
    <br />
    <br />
    {content.rest}
  </Fragment>
</ContentSection>
